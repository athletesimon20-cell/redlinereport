# Public — safe to expose to the browser (the client SDK needs these to talk to Sanity's API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only — used to read draft/unpublished content in the app if you ever want
# preview mode. Not required for the Studio itself or for published content.
# SANITY_API_READ_TOKEN=

# Server-only — only needed to run `npm run migrate:sanity` once. Generate at
# sanity.io/manage -> your project -> API -> Tokens -> Add API token (Editor permissions).
# Never commit this.
# SANITY_WRITE_TOKEN=

# Shared secret for the on-demand revalidate webhook (app/api/revalidate/route.ts).
# Make up any random string and use the same value in Sanity's webhook config.
# SANITY_REVALIDATE_SECRET=
